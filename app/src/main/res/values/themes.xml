<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.FormLogRegiss" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/persona_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/persona_black</item>
        <item name="colorSurface">@color/persona_black</item>
        <item name="colorOnSurface">@color/persona_white</item>
    </style>

    <style name="Theme.FormLogRegiss" parent="Base.Theme.FormLogRegiss" />

    <style name="PersonaEditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/persona_white</item>
        <item name="android:textColorHint">#88FFFFFF</item>
        <item name="android:padding">12dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="PersonaButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/persona_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="cornerRadius">0dp</item>
    </style>
</resources>